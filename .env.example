APP_NAME=LudoPlatform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Vue frontend origin(s) allowed by CORS. Comma-separate multiple origins
# (e.g. the local dev server and the public HTTPS URL used by Telegram).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ludo_platform
DB_USERNAME=postgres
DB_PASSWORD=

# Sessions (only used by web routes; the API is stateless)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & queues
CACHE_STORE=redis
CACHE_PREFIX=ludo_cache_
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=local

# Redis (predis = pure-PHP client, no PHP extension required)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=ludo_database_

# Telegram (never commit the real token)
TELEGRAM_BOT_TOKEN=

# Broadcasting / Laravel Reverb
BROADCAST_CONNECTION=reverb

# Generate with: php artisan reverb:install (or any random strings)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host/port/scheme that clients (Laravel Echo) connect to
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Interface/port the Reverb server process binds to
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Set to true when running multiple Reverb servers (coordinates via Redis pub/sub)
REVERB_SCALING_ENABLED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
